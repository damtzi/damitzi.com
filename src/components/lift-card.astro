---
import { formatTime } from '@/lib/utils';

interface Props {
	date: string;
	maxHeartRate: number;
	movingTime: number; // seconds
}

const { date, maxHeartRate, movingTime } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-GB', {
	day: '2-digit',
	month: 'short',
	year: 'numeric'
});
---

<div class="flex flex-col gap-2 rounded-md border border-gray-300 bg-background px-4 py-2 shadow">
	<h3>{formattedDate}</h3>
	<div class="grid grid-cols-2">
		<div class="flex flex-col text-sm">
			<span class="text-gray-500">Max Heart Rate</span>
			<span class="font-mono">{maxHeartRate}</span>
		</div>
		<div class="flex flex-col text-sm">
			<span class="text-gray-500">Duration</span>
			<span class="font-mono">{formatTime(movingTime)} mm:ss</span>
		</div>
	</div>
</div>
