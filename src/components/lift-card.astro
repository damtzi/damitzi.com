---
import { formatTime } from '@/lib/utils';

type Props = {
	date: string;
	maxHeartRate: number;
	movingTime: number; // seconds
};

const { date, maxHeartRate, movingTime } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-GB', {
	day: '2-digit',
	month: 'short',
	year: 'numeric'
});
---

<div
	class="flex flex-col gap-3 rounded-lg border border-foreground/10 bg-surface px-4 py-3 shadow-sm"
>
	<h3 class="font-medium">{formattedDate}</h3>
	<div class="grid grid-cols-2 gap-2">
		<div class="flex flex-col gap-0.5">
			<span class="text-xs font-medium tracking-wider text-foreground/40 uppercase"
				>Max Heart Rate</span
			>
			<span class="font-mono text-sm tabular-nums">{maxHeartRate}</span>
		</div>
		<div class="flex flex-col gap-0.5">
			<span class="text-xs font-medium tracking-wider text-foreground/40 uppercase">Duration</span>
			<span class="font-mono text-sm tabular-nums">{formatTime(movingTime)}mm:ss</span>
		</div>
	</div>
</div>
