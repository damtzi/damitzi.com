---
import { cn } from '@/lib/utils';

const pathname = Astro.url.pathname;

const links = [
	{ href: '/', label: 'home', active: pathname === '/' },
	{ href: '/about', label: 'about', active: pathname.includes('/about') },
	{ href: '/projects', label: 'projects', active: pathname.includes('/projects') },
	{ href: '/hobbies', label: 'hobbies', active: pathname.includes('/hobbies') },
	{ href: '/music', label: 'music', active: pathname.includes('/music') },
	{ href: '/bread', label: 'bread', active: pathname.includes('/bread') },
	{ href: '/socials', label: 'socials', active: pathname.includes('/socials') }
];
---

<nav class="sticky top-10 flex flex-col gap-1" aria-label="Site index">
	<p class="mb-4 font-mono text-[0.65rem] tracking-[0.14em] text-foreground/45 uppercase">Index</p>
	{
		links.map((link, index) => (
			<a
				href={link.href}
				aria-current={link.active ? 'page' : undefined}
				class={cn(
					'group flex items-baseline gap-3 py-1.5 font-serif text-lg text-foreground/50 transition-colors duration-150 ease-out hover:text-foreground',
					link.active && 'text-foreground'
				)}
			>
				<span
					class={cn('font-mono text-[0.6rem] text-foreground/30', link.active && 'text-accent')}
				>
					{String(index + 1).padStart(2, '0')}
				</span>
				<span>{link.label}</span>
			</a>
		))
	}
</nav>
