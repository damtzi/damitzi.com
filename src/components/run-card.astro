---
import { formatTime } from '@/lib/utils';

type Props = {
	date: string;
	distance: number; // meters
	movingTime: number; // seconds
};

const { date, distance, movingTime } = Astro.props;

const distanceKm = distance / 1000;
const paceSecondsPerKm = movingTime / distanceKm;
const paceMinutes = Math.floor(paceSecondsPerKm / 60);
const paceSeconds = Math.round(paceSecondsPerKm % 60);

const stats = {
	distance: `${distanceKm.toFixed(2)}km`,
	pace: `${paceMinutes}:${paceSeconds.toString().padStart(2, '0')}/km`,
	formattedDate: new Date(date).toLocaleDateString('en-GB', {
		day: '2-digit',
		month: 'short',
		year: 'numeric'
	})
};
---

<div
	class="flex flex-col gap-3 rounded-lg border border-foreground/10 bg-surface px-4 py-3 shadow-sm"
>
	<h3 class="font-medium">{stats.formattedDate}</h3>
	<div class="grid grid-cols-3 gap-2">
		<div class="flex flex-col gap-0.5">
			<span class="text-xs font-medium tracking-wider text-foreground/40 uppercase">Distance</span>
			<span class="font-mono text-sm tabular-nums">{stats.distance}</span>
		</div>
		<div class="flex flex-col gap-0.5">
			<span class="text-xs font-medium tracking-wider text-foreground/40 uppercase">Pace</span>
			<span class="font-mono text-sm tabular-nums">{stats.pace}</span>
		</div>
		<div class="flex flex-col gap-0.5">
			<span class="text-xs font-medium tracking-wider text-foreground/40 uppercase">Duration</span>
			<span class="font-mono text-sm whitespace-nowrap tabular-nums"
				>{formatTime(movingTime)}mm:ss</span
			>
		</div>
	</div>
</div>
