---
import ExternalLinkIcon from '@lucide/astro/icons/external-link';
import { TypographyH4, TypographyP } from '@/components/typography';

type Props = {
	title: string;
	description: string;
	link: string;
	tech: string[];
	githubUrl?: string;
};

const { title, description, link, tech, githubUrl } = Astro.props;
---

<article class="flex flex-col gap-3 border-t border-foreground/15 py-5 last:border-b">
	<TypographyH4>
		{title}
	</TypographyH4>
	<TypographyP>{description}</TypographyP>
	<div
		class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-[0.65rem] tracking-[0.08em] text-foreground/55 uppercase"
	>
		{
			tech.map((techItem) => (
				<span class="after:ml-3 after:text-foreground/25 after:content-['/'] last:after:hidden">
					{techItem}
				</span>
			))
		}
	</div>
	<div
		class="flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[0.65rem] tracking-[0.08em] uppercase"
	>
		<a
			href={link}
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center gap-1 text-accent hover:underline"
		>
			<ExternalLinkIcon class="h-4 w-4" />
			View Project
		</a>
		{
			githubUrl && (
				<a
					href={githubUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-1 text-accent hover:underline"
				>
					<svg
						class="h-4 w-4"
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
						<path d="M9 18c-4.51 2-5-2-7-2" />
					</svg>
					View Source
				</a>
			)
		}
	</div>
</article>
