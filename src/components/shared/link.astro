---
interface Props {
	href: string;
	external?: boolean;
	class?: string;
}

const { href, external = false, class: className } = Astro.props;
---

<a
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	class:list={[
		'text-inherit underline decoration-foreground/25 decoration-1 underline-offset-[2.5px] transition-colors duration-150 ease-out hover:decoration-foreground/60 focus-visible:rounded-xs focus-visible:decoration-foreground/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
		className
	]}><slot /></a
>
