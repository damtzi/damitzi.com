---
type Props = {
	href: string;
	external?: boolean;
	class?: string;
};

const { href, external = false, class: className } = Astro.props;
---

<a
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	class:list={[
		'text-accent underline decoration-accent/25 underline-offset-[0.18em] transition-colors duration-150 ease-out hover:decoration-accent',
		className
	]}><slot /></a
>
