---
interface Props {
	href: string;
	external?: boolean;
	class?: string;
}

const { href, external = false, class: className } = Astro.props;
---

<a
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	class:list={[
		'text-gray-400 transition-colors duration-150 ease-out hover:cursor-pointer hover:text-accent',
		className
	]}><slot /></a
>
