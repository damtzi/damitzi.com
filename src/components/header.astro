---
import ThemeToggle from '@/components/theme-toggle.svelte';

const pathname = Astro.url.pathname;
const links = [
	{ href: '/work', label: 'Work', active: pathname.startsWith('/work') },
	{ href: '/interests', label: 'Interests', active: pathname.startsWith('/interests') },
	{ href: '/about', label: 'About', active: pathname === '/about' }
];
---

<header class="site-header">
	<div class="site-header__inner">
		<a href="/" class="identity" aria-label="Damian Tziamtzis, home">
			<span class="identity__mark" aria-hidden="true"></span>
			<span class="identity__name">Damian T.</span>
		</a>

		<div class="site-header__actions">
			<nav aria-label="Primary navigation">
				<ul class="primary-nav">
					{
						links.map((link) => (
							<li>
								<a href={link.href} aria-current={link.active ? 'page' : undefined}>
									<span class="nav-dot" aria-hidden="true" />
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<ThemeToggle client:load />
		</div>
	</div>
</header>
