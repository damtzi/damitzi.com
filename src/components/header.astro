---
import pureBlue from '@/assets/0007fb.png';
import MobileNav from '@/components/mobile-nav.svelte';
---

<header class="grid grid-cols-[1fr_auto] items-center gap-x-4 border-b border-foreground/15 pb-5">
	<a href="/" class="group flex w-fit items-center gap-4" aria-label="Damian Tziamtzis — home">
		<span class="relative grid h-9 w-9 shrink-0 place-items-center" aria-hidden="true">
			<span class="absolute inset-1 rounded-full border border-foreground/25"></span>
			<span class="absolute top-1/2 h-px w-full bg-foreground/25"></span>
			<span class="absolute left-1/2 h-full w-px bg-foreground/25"></span>
			<img
				src={pureBlue.src}
				alt=""
				class="relative h-3 w-3 rounded-full transition-transform duration-300 group-hover:scale-125"
				width={12}
				height={12}
			/>
		</span>
		<span class="flex flex-col gap-1">
			<span class="font-serif text-2xl leading-none font-medium tracking-[-0.025em] sm:text-3xl">
				Damian Tziamtzis
			</span>
			<span class="font-mono text-[0.65rem] tracking-[0.12em] text-foreground/55 uppercase">
				Software Engineer · Gdynia, Poland
			</span>
		</span>
	</a>
	<MobileNav client:load pathname={Astro.url.pathname} />
</header>
