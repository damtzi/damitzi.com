---
// No-flash theme: runs before paint, re-applies after view transitions.
---

<script is:inline>
	const applyTheme = (doc = document) => {
		const theme =
			localStorage.getItem('theme') ??
			(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		doc.documentElement.classList.toggle('dark', theme === 'dark');
	};

	applyTheme();
	// Apply the theme to the incoming document *before* the swap. Astro replaces
	// all <html> attributes during the swap and scrolls (forcing a style flush)
	// before astro:after-swap fires, so re-applying it afterwards briefly renders
	// light mode and the persisted body's color transition flashes.
	document.addEventListener('astro:before-swap', (event) => applyTheme(event.newDocument));
</script>
