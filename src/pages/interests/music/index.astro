---
import BaseLayout from '@/layouts/base.astro';
import VinylPng from '@/assets/black-vinyl.png';
import CdPng from '@/assets/clear-cd.png';
import { getDiscogsCollection } from '@/lib/discogs';
import { getCollection } from 'astro:content';
import { dateFormatter } from '@/lib/utils';

const collection = await getDiscogsCollection();
const releases = collection.releases
	.toSorted((a, b) => new Date(b.date_added).getTime() - new Date(a.date_added).getTime())
	.slice(0, 4);
const isVinyl = (formats: { name: string }[]) => formats.some((format) => format.name === 'Vinyl');
const topPicks = (await getCollection('topPicks', ({ data }) => data.published)).toSorted((a, b) =>
	b.id.localeCompare(a.id)
);
const concerts = (await getCollection('concerts'))
	.toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 4);
---

<BaseLayout title="Music" description="Records, concerts, and annual album picks." wide>
	<header>
		<a class="back-link text-link" href="/interests">← Interests</a>
		<p class="eyebrow">Music</p>
		<h1 class="page-title">Listening closely, <span class="serif-accent">keeping track.</span></h1>
		<p class="lede">
			Records collected, shows attended, and the albums that stayed in rotation long enough to
			define a year.
		</p>
	</header>

	<section class="content-section" aria-labelledby="music-recent">
		<h2 id="music-recent" class="section-label">Recent pickups</h2>
		<div class="record-grid">
			{
				releases.map((release) => (
					<a
						href={`/interests/music/vinyls/${release.id}`}
						class="record"
						aria-label={release.basic_information.title}
					>
						<img
							src={release.basic_information.cover_image}
							alt=""
							width="220"
							height="220"
							loading="lazy"
							class="record__cover"
						/>
						<img
							src={isVinyl(release.basic_information.formats) ? VinylPng.src : CdPng.src}
							alt=""
							width="220"
							height="220"
							loading="lazy"
							class="record__disc"
						/>
						<span class="record__title">{release.basic_information.title}</span>
					</a>
				))
			}
		</div>
		<p class="section-more">
			<a class="text-link" href="/interests/music/vinyls">Full collection</a>
			<span aria-hidden="true"> · </span>
			<a class="text-link" href="https://www.discogs.com/user/damitzi__">Discogs profile ↗</a>
		</p>
	</section>

	<div class="music-columns content-section">
		<section aria-labelledby="annual-picks">
			<h2 id="annual-picks" class="section-label">Annual picks</h2>
			<ul class="simple-list">
				{
					topPicks.slice(0, 4).map((pick) => (
						<li>
							<a href={`/interests/music/top-picks/${pick.id}`}>
								<>
									<span>{pick.data.title}</span>
									<span aria-hidden="true">→</span>
								</>
							</a>
						</li>
					))
				}
			</ul>
			<p class="section-more">
				<a class="text-link" href="/interests/music/top-picks">All years</a>
			</p>
		</section>
		<section aria-labelledby="recent-shows">
			<h2 id="recent-shows" class="section-label">Recent shows</h2>
			<ul class="simple-list">
				{
					concerts.map((concert) => (
						<li>
							<>
								<span>
									<>
										<strong>{concert.data.artist}</strong>
										<small>{concert.data.location}</small>
									</>
								</span>
								<span class="meta">{dateFormatter(concert.data.date)}</span>
							</>
						</li>
					))
				}
			</ul>
			<p class="section-more">
				<a class="text-link" href="/interests/music/concerts">Concert log</a>
			</p>
		</section>
	</div>
</BaseLayout>
