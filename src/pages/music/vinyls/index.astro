---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/base.astro';
import Breadcrumbs from '@/components/shared/breadcrumbs.astro';
import { TypographyH1 } from '@/components/typography';
import VinylPng from '@/assets/black-vinyl.png';
import CdPng from '@/assets/clear-cd.png';

const releases = (await getCollection('vinyls')).sort((a, b) =>
	a.data.artists[0].localeCompare(b.data.artists[0])
);

const isVinyl = (formats: string[]) => formats.includes('Vinyl');
---

<BaseLayout title="Vinyls" description="My vinyl and CD collection">
	<div class="flex flex-col gap-2">
		<TypographyH1>Music</TypographyH1>
		<Breadcrumbs />
		<div class="grid grid-cols-2 gap-4 sm:grid-cols-4 md:gap-10">
			{
				releases.map((release) => (
					<a href={`/music/vinyls/${release.id}`} class="group relative">
						<img
							src={release.data.cover.src}
							alt={release.data.title}
							width={200}
							height={200}
							transition:name={`vinyl-cover-${release.id}`}
							class="relative z-10 aspect-square rounded-xs shadow-lg transition-all duration-300 hover:scale-105 hover:cursor-pointer hover:shadow"
						/>
						<img
							src={isVinyl(release.data.formats) ? VinylPng.src : CdPng.src}
							alt={isVinyl(release.data.formats) ? 'A black vinyl record' : 'A clear CD'}
							width={200}
							height={200}
							class="absolute top-0 z-0 opacity-0 transition-all duration-300 group-hover:translate-x-10 group-hover:opacity-100"
						/>
					</a>
				))
			}
		</div>
	</div>
</BaseLayout>
