---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/base.astro';
import Breadcrumbs from '@/components/shared/breadcrumbs.astro';
import { TypographyH1 } from '@/components/typography';

export const getStaticPaths = (async () => {
	const vinyls = await getCollection('vinyls');
	return vinyls.map((vinyl) => ({ params: { slug: vinyl.id }, props: { vinyl } }));
}) satisfies GetStaticPaths;

type Props = { vinyl: CollectionEntry<'vinyls'> };
const { vinyl } = Astro.props as Props;
---

<BaseLayout title={vinyl.data.title} description={`${vinyl.data.title} details`}>
	<div class="flex flex-col gap-2">
		<TypographyH1>{vinyl.data.title}</TypographyH1>
		<Breadcrumbs labels={{ [vinyl.id]: vinyl.data.title }} />
		<div class="flex flex-col gap-8 md:flex-row">
			<img
				src={vinyl.data.cover.src}
				alt={`Cover for ${vinyl.data.title}`}
				width={400}
				height={400}
				transition:name={`vinyl-cover-${vinyl.id}`}
				class="rounded-xs shadow-lg"
			/>
			<div class="flex flex-col gap-4">
				<div class="flex flex-col">
					<span class="text-sm text-muted">Album</span>
					<span>{vinyl.data.title}</span>
				</div>
				<div class="flex flex-col">
					<span class="text-sm text-muted">Artist</span>
					<span>{vinyl.data.artists.join(', ')}</span>
				</div>
				<div class="flex flex-col">
					<span class="text-sm text-muted">Label</span>
					<span>{vinyl.data.labels.join(', ')}</span>
				</div>
				<div class="flex flex-col">
					<span class="text-sm text-muted">Format</span>
					<span>{vinyl.data.formats.join(', ')}</span>
				</div>
				<div class="flex flex-col">
					<span class="text-sm text-muted">Genres</span>
					<span>{vinyl.data.genres.join(', ')}</span>
				</div>
				<div class="flex flex-col">
					<span class="text-sm text-muted">Released</span>
					<span>{vinyl.data.released}</span>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>
