---
import BaseLayout from '@/layouts/base.astro';
import Breadcrumbs from '@/components/shared/breadcrumbs.astro';
import Arrow from '@/components/shared/arrow.astro';
import { TypographyH1, TypographyP } from '@/components/typography';
import { getCollection } from 'astro:content';

const topPicks = (await getCollection('topPicks', ({ data }) => data.published)).sort((a, b) =>
	b.id.localeCompare(a.id)
);
---

<BaseLayout title="Top Picks" description="My favorite albums of the year">
	<div class="flex flex-col gap-2">
		<TypographyH1>My Top Picks</TypographyH1>
		<TypographyP>
			Since 2020 I have been writing down all the albums I have listened to that year and ranking
			them. I do not follow any universal ranking system, but rather rely on my personal taste and
			listening habits.
		</TypographyP>
		<Breadcrumbs />
		<ul class="w-fit space-y-2">
			{
				topPicks.map((topPick) => (
					<li class="group flex items-center gap-2">
						<Arrow />
						<a
							href={`/music/top-picks/${topPick.id}`}
							class="text-gray-400 transition-colors duration-150 ease-out hover:cursor-pointer hover:text-pure-blue"
						>
							{topPick.data.title}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>
