---
import BaseLayout from '@/layouts/base.astro';
import Breadcrumbs from '@/components/shared/breadcrumbs.astro';
import { TypographyH1 } from '@/components/typography';
import { dateFormatter } from '@/lib/utils';
import { getCollection, type CollectionEntry } from 'astro:content';

type Concert = CollectionEntry<'concerts'>['data'];

const concerts = (await getCollection('concerts')).map((entry) => entry.data);

// Sort concerts by date (newest first)
const sortedConcerts = concerts.sort((a, b) => b.date.getTime() - a.date.getTime());

// Group concerts by year
const concertsByYear = sortedConcerts.reduce(
	(acc, concert) => {
		const year = concert.date.getFullYear();
		acc[year] ??= [];
		acc[year].push(concert);
		return acc;
	},
	{} as Record<number, Concert[]>
);

// Years in descending order
const years = Object.keys(concertsByYear)
	.map(Number)
	.sort((a, b) => b - a);
---

<BaseLayout title="My Concerts" description="Concerts I've attended over the years">
	<div class="flex flex-col gap-4">
		<TypographyH1>My Concerts</TypographyH1>
		<Breadcrumbs />
		<div class="w-full space-y-6">
			{
				years.map((year) => (
					<div class="space-y-2">
						<h2 class="font-mono text-xs tracking-[0.12em] text-foreground/50 uppercase">{year}</h2>
						<ul class="editorial-list">
							{concertsByYear[year].map((concert) => (
								<li class="group flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between">
									<span class="font-serif text-lg">{concert.artist}</span>
									<span class="font-mono text-[0.65rem] tracking-[0.04em] text-foreground/55 uppercase">
										{dateFormatter(concert.date)} @ {concert.location}
										{concert.festival && ` [${concert.festival} Festival]`}
									</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</BaseLayout>
