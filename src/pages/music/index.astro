---
import BaseLayout from '@/layouts/base.astro';
import Arrow from '@/components/shared/arrow.astro';
import Breadcrumbs from '@/components/shared/breadcrumbs.astro';
import { TypographyH1 } from '@/components/typography';

const links = [
	{ href: '/music/vinyls', text: 'Vinyl collection' },
	{ href: '/music/concerts', text: 'Concert tracker' },
	{ href: '/music/top-picks', text: 'Top picks' }
];
---

<BaseLayout title="Music" description="Explore my music collection and concert tracker">
	<div class="flex flex-col gap-2">
		<TypographyH1>Music</TypographyH1>
		<Breadcrumbs />
		<ul class="w-fit space-y-2">
			{
				links.map((link) => (
					<li class="group flex items-center gap-2">
						<Arrow />
						<a
							href={link.href}
							class="text-gray-400 transition-colors duration-150 ease-out hover:cursor-pointer hover:text-pure-blue"
						>
							{link.text}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>
