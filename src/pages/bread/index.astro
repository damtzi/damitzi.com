---
import BaseLayout from '@/layouts/base.astro';
import Breadcrumbs from '@/components/shared/breadcrumbs.astro';
import Arrow from '@/components/shared/arrow.astro';
import { TypographyH1 } from '@/components/typography';
import { getCollection } from 'astro:content';

const recipes = await getCollection('recipes', ({ data }) => data.published);
---

<BaseLayout title="Recipes" description="Browse my recipes for bread and other baked goods">
	<div class="flex flex-col gap-2">
		<TypographyH1>Bread recipes</TypographyH1>
		<Breadcrumbs />
		<ul class="w-fit space-y-2">
			{
				recipes.map((recipe) => (
					<li class="group flex items-center gap-2">
						<Arrow />
						<a
							href={`/bread/${recipe.id}`}
							class="text-gray-400 transition-colors duration-150 ease-out hover:cursor-pointer hover:text-pure-blue"
						>
							{recipe.data.title}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>
