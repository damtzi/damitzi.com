---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/base.astro';
import Breadcrumbs from '@/components/shared/breadcrumbs.astro';
import { TypographyH1, TypographyP } from '@/components/typography';
import { getCollection, render } from 'astro:content';

export const getStaticPaths = (async () => {
	const recipes = await getCollection('recipes', ({ data }) => data.published);
	return recipes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<article class="flex flex-col gap-2">
		<TypographyH1>{entry.data.title}</TypographyH1>
		<Breadcrumbs />
		<TypographyP class="lead">{entry.data.description}</TypographyP>
		<div
			class="prose dark:prose-invert prose-h1:text-xl prose-h1:font-bold prose-p:text-justify prose-p:text-foreground prose-a:text-pure-blue prose-img:rounded-xl"
		>
			<Content />
		</div>
	</article>
</BaseLayout>
