---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/base.astro';
import Link from '@/components/shared/link.astro';
import { TypographyH1, TypographyH2, TypographyP } from '@/components/typography';
import VinylPng from '@/assets/black-vinyl.png';
import CdPng from '@/assets/clear-cd.png';
import { workExperience } from '@/data/work-experience';

const releases = (await getCollection('vinyls'))
	.sort((a, b) => b.data.added.getTime() - a.data.added.getTime())
	.slice(0, 4);

const isVinyl = (formats: string[]) => formats.includes('Vinyl');
const additionalWork = [
	...workExperience.filter((entry) => entry.homepageSection === 'additional'),
	{
		company: 'Fundacja Kompetencji Cyfrowych',
		homepageCompany: undefined,
		role: 'Frontend Engineer',
		website: 'https://www.cyfrowe.org/',
		icon: '/company-icons/cyfrowe.png'
	}
];
const workSections = [
	{
		title: 'Experience',
		entries: workExperience.filter((entry) => entry.homepageSection !== 'additional')
	},
	{
		title: 'Additional Work',
		entries: additionalWork
	}
];
---

<BaseLayout title="Home" description="Home page">
	<div class="stagger-animation flex flex-col gap-8">
		<section class="flex flex-col gap-2">
			<TypographyH1>Welcome</TypographyH1>
			<TypographyP class="text-sm text-muted">Cześć, γεια σου, hello</TypographyP>
			<TypographyP>
				I'm Damian, an engineer who builds <Link href="/projects">products</Link> with effort and care.
				I pay attention to the finer details, aesthetics, and how people interact with technology. I'm
				interested in design and web development, and I keep learning as AI reshapes how we build.
			</TypographyP>
			<TypographyP>
				Away from the screen, I <Link href="/music/vinyls">collect vinyl records</Link> and
				<Link href="/bread">bake bread</Link>.
			</TypographyP>
			<TypographyP>
				You can check out my work on <Link href="https://github.com/damtzi" external>GitHub</Link>,
				trade records with me on
				<Link href="https://www.discogs.com/user/damitzi__" external>Discogs</Link>, connect with me
				on <Link href="https://bsky.app/profile/damitzi.com" external>BlueSky</Link>,
				<Link href="https://x.com/damitzi__" external>Twitter</Link>,
				<Link href="https://www.instagram.com/damitzi__" external>Instagram</Link>, or drop me an
				<Link href="mailto:damian.tziamtzis@gmail.com">email</Link>.
			</TypographyP>
		</section>

		{
			workSections.map((section) => (
				<section class="flex flex-col gap-3">
					<TypographyH2>{section.title}</TypographyH2>
					<ul class="flex flex-col gap-2.5">
						{section.entries.map((entry) => (
							<li class="flex min-w-0 items-center gap-2">
								<img
									src={entry.icon}
									alt=""
									width="20"
									height="20"
									loading="lazy"
									class="size-5 shrink-0 rounded-sm border border-foreground/10 object-cover"
								/>
								<p class="min-w-0 flex-1 truncate">
									{entry.role}
									<span class="text-muted"> at </span>
									<Link href={entry.website} external class="font-medium">
										{entry.homepageCompany ?? entry.company}
									</Link>
								</p>
							</li>
						))}
					</ul>
				</section>
			))
		}

		<section class="flex flex-col gap-2">
			<TypographyH2>Recent Pickups</TypographyH2>
			<ul class="grid grid-cols-2 gap-4 sm:grid-cols-4 md:gap-10">
				{
					releases.map((release) => (
						<li>
							<a href={`/music/vinyls/${release.id}`} class="group relative block">
								<img
									src={release.data.cover.src}
									alt={release.data.title}
									width={200}
									height={200}
									transition:name={`vinyl-cover-${release.id}`}
									class="relative z-10 aspect-square rounded-xs shadow-lg transition-all duration-300 hover:scale-105 hover:cursor-pointer hover:shadow"
								/>
								<img
									src={isVinyl(release.data.formats) ? VinylPng.src : CdPng.src}
									alt={isVinyl(release.data.formats) ? 'A black vinyl record' : 'A clear CD'}
									width={200}
									height={200}
									class="absolute top-0 z-0 opacity-0 transition-all duration-300 group-hover:translate-x-10 group-hover:opacity-100"
								/>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</BaseLayout>

<style>
	@media (prefers-reduced-motion: no-preference) {
		/* Target all direct children of the stagger-animation container.
		   Skipped after the first navigation so it only animates on initial load. */
		:root:not([data-navigated]) .stagger-animation > * {
			opacity: 0;
			transform: translateY(-10px);
			animation: fadeInDown 0.6s ease-out forwards;
		}

		.stagger-animation > :nth-child(1) {
			animation-delay: 0.1s;
		}
		.stagger-animation > :nth-child(2) {
			animation-delay: 0.3s;
		}
		.stagger-animation > :nth-child(3) {
			animation-delay: 0.5s;
		}
		.stagger-animation > :nth-child(4) {
			animation-delay: 0.7s;
		}

		@keyframes fadeInDown {
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}
	}
</style>
