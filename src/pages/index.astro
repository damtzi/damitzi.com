---
import BaseLayout from '@/layouts/base.astro';
import Link from '@/components/shared/link.astro';
import { TypographyH1, TypographyH2, TypographyP } from '@/components/typography';
import VinylPng from '@/assets/black-vinyl.png';
import CdPng from '@/assets/clear-cd.png';
import { getDiscogsCollection } from '@/lib/discogs';

const collection = await getDiscogsCollection();

const releases = collection.releases
	.sort((a, b) => new Date(b.date_added).getTime() - new Date(a.date_added).getTime())
	.slice(0, 4);

const isVinyl = (formats: { name: string }[]) => formats.some((format) => format.name === 'Vinyl');
---

<BaseLayout title="Home" description="Home page">
	<div class="stagger-animation flex flex-col gap-8">
		<div class="flex flex-col gap-2">
			<TypographyH1>Welcome</TypographyH1>
			<TypographyP>
				Hello there! Welcome to my personal website. Here you can find: information <Link
					href="/about">about me</Link
				>, my <Link href="/projects">projects</Link>, my
				<Link href="/music/vinyls">vinyl collection</Link>, my
				<Link href="/music/top-picks">top picks</Link>, my
				<Link href="/socials">social links</Link>, my
				<Link href="/hobbies">hobbies</Link>, and my
				<Link href="/bread">bread</Link>.
			</TypographyP>
			<TypographyP>
				You can check out my work on <Link href="https://github.com/damtzi" external>GitHub</Link>,
				follow me on
				<Link href="https://bsky.app/profile/damitzi.com" external>Bluesky</Link>,
				<Link href="https://www.instagram.com/damitzi__" external>Instagram</Link>,
				<Link href="https://www.discogs.com/user/damitzi__" external>Discogs</Link>, or drop me an
				email at
				<Link href="mailto:damian.tziamtzis@gmail.com">damian.tziamtzis@gmail.com</Link>.
			</TypographyP>
		</div>

		<div class="flex flex-col gap-2">
			<TypographyH2>Recent pickups</TypographyH2>
			<div class="grid grid-cols-2 gap-4 sm:grid-cols-4 md:gap-10">
				{
					releases.map((release) => (
						<a href={`/music/vinyls/${release.id}`} class="group relative">
							<img
								src={release.basic_information.cover_image}
								alt={release.basic_information.title}
								width={200}
								height={200}
								transition:name={`vinyl-cover-${release.id}`}
								class="relative z-10 aspect-square rounded-xs shadow-lg transition-all duration-300 hover:scale-105 hover:cursor-pointer hover:shadow"
							/>
							<img
								src={isVinyl(release.basic_information.formats) ? VinylPng.src : CdPng.src}
								alt={
									isVinyl(release.basic_information.formats) ? 'A black vinyl record' : 'A clear CD'
								}
								width={200}
								height={200}
								class="absolute top-0 z-0 opacity-0 transition-all duration-300 group-hover:translate-x-10 group-hover:opacity-100"
							/>
						</a>
					))
				}
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	@media (prefers-reduced-motion: no-preference) {
		/* Target all direct children of the stagger-animation container.
		   Skipped after the first navigation so it only animates on initial load. */
		:root:not([data-navigated]) .stagger-animation > * {
			opacity: 0;
			transform: translateY(-10px);
			animation: fadeInDown 0.6s ease-out forwards;
		}

		.stagger-animation > :nth-child(1) {
			animation-delay: 0.1s;
		}
		.stagger-animation > :nth-child(2) {
			animation-delay: 0.3s;
		}

		@keyframes fadeInDown {
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}
	}
</style>
