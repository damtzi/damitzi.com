---
import BaseLayout from '@/layouts/base.astro';

const timeline = [
	{ period: '2026-now', title: 'Product engineer', place: 'Campy · OKE · SoftMetal' },
	{ period: '2020-2025', title: 'Frontend engineer', place: 'Secretarium' },
	{ period: '2017-2020', title: 'Computer Science', place: 'Lancaster University' }
];
---

<BaseLayout title="About" description="About Damian Tziamtzis, a product engineer in Gdynia.">
	<header>
		<p class="eyebrow">About</p>
		<h1 class="page-title">
			Engineer by trade, <span class="serif-accent">collector of interests</span> by nature.
		</h1>
	</header>

	<section class="content-section about-copy prose-editorial">
		<p>
			I’m Damian, a product engineer based in Gdynia, Poland. I grew up around computers, studied
			Computer Science at Lancaster, and found my way into building products by caring as much about
			how they feel as how they work.
		</p>
		<p>
			My work spans mobile subscriptions, travel booking, commodity trading, developer tools, and
			confidential AI. The domain changes; the through-line is turning complicated systems into
			clear, reliable experiences.
		</p>
		<p>
			Outside work, I’m usually listening to an album, at a concert, baking bread, following
			basketball, or negotiating space with one dog and three cats.
		</p>
	</section>

	<section class="content-section" aria-labelledby="path">
		<h2 id="path" class="section-label">A short path</h2>
		<ol class="timeline">
			{
				timeline.map((item) => (
					<li>
						<>
							<span class="meta">{item.period}</span>
							<div>
								<>
									<strong>{item.title}</strong>
									<p>{item.place}</p>
								</>
							</div>
						</>
					</li>
				))
			}
		</ol>
	</section>

	<section class="content-section about-links" aria-labelledby="more">
		<h2 id="more" class="section-label">More</h2>
		<p>
			<a class="text-link" href="/resume-damian-tziamtzis.pdf">Read my résumé</a>, see what I
			<a class="text-link" href="/uses">use</a>, or
			<a class="text-link" href="mailto:damian.tziamtzis@gmail.com">send an email</a>.
		</p>
	</section>
</BaseLayout>
