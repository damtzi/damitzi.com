---
import BaseLayout from '@/layouts/base.astro';
import { TypographyH1, TypographyH2, TypographyH3, TypographyP } from '@/components/typography';
import { workExperience } from '@/data/work-experience';

type CvEntry = {
	title: string;
	meta: string;
	description?: string;
	items: string[];
};

const education: CvEntry[] = [
	{
		title: 'Lancaster University',
		meta: '2017-2020',
		description: 'BSc Hons Computer Science, First Class Honours',
		items: [
			'Advanced programming: OOP, recursion, functional programming.',
			'Operating systems: file systems, semaphores, concurrency, race conditions.',
			'Software design: object-oriented design, use cases, statecharts.',
			'Human-computer interaction and UX design principles.',
			'Internet applications engineering: responsive web design and web development.'
		]
	}
];
---

<BaseLayout title="About" description="About me">
	<div class="flex flex-col gap-8">
		<div class="flex flex-col gap-2">
			<TypographyH1>About Me</TypographyH1>
			<TypographyP>
				I am a product engineer based in Gdynia with deep React, Next.js, and TypeScript experience
				across travel, subscriptions, privacy tech, and AI products. I've led frontend work from
				early product shaping through production delivery, including booking funnels, paywalls,
				developer tools, CMS platforms, and mobile experiences. I care about clear UX, reliable
				systems, and shipping work that moves the product.
			</TypographyP>
		</div>

		<section class="flex flex-col gap-5">
			<TypographyH2>Work Experience</TypographyH2>
			{
				workExperience.map((entry) => (
					<article class="flex flex-col gap-2 border-l border-gray-200 pl-4 dark:border-gray-700">
						<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
							<TypographyH3>{entry.company}</TypographyH3>
							<p class="font-mono text-sm text-muted">
								{entry.period} / {entry.location}
							</p>
						</div>
						<p class="font-medium">{entry.role}</p>
						<ul class="list-disc space-y-1 pl-5 text-gray-700 dark:text-gray-300">
							{entry.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</article>
				))
			}
		</section>

		<section class="flex flex-col gap-5">
			<TypographyH2>Education</TypographyH2>
			{
				education.map((entry) => (
					<article class="flex flex-col gap-2 border-l border-gray-200 pl-4 dark:border-gray-700">
						<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
							<TypographyH3>{entry.title}</TypographyH3>
							<p class="font-mono text-sm text-muted">{entry.meta}</p>
						</div>
						{entry.description && <p class="font-medium">{entry.description}</p>}
						<ul class="list-disc space-y-1 pl-5 text-gray-700 dark:text-gray-300">
							{entry.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</article>
				))
			}
		</section>
	</div>
</BaseLayout>
