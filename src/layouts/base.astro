---
import '@/styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/lora';
import '@fontsource/ibm-plex-mono';

import { ClientRouter } from 'astro:transitions';
import FloatingNav from '@/components/floating-nav.svelte';
import Footer from '@/components/footer.astro';
import Header from '@/components/header.astro';
import Theme from '@/components/theme.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{`${title} | Damian T`}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<Theme />
		<ClientRouter />
		<script is:inline>
			// Mark the document once a view transition occurs so first-load-only
			// animations don't re-run on client-side navigation. Must run after
			// the swap, since Astro overwrites <html> attributes during it.
			document.addEventListener('astro:after-swap', () => {
				document.documentElement.setAttribute('data-navigated', '');
			});
		</script>
	</head>
	<body
		class="antialised relative bg-background font-sans text-foreground transition-colors duration-300 ease-out"
		transition:persist
	>
		<div
			class="mx-auto grid min-h-dvh w-full max-w-2xl grid-cols-1 grid-rows-[auto_1fr_auto] gap-y-8 px-4 py-8"
		>
			<div class="mx-auto w-full max-w-2xl">
				<Header />
			</div>
			<main class="mx-auto w-full max-w-2xl" transition:animate="fade">
				<slot />
			</main>
			<div class="mx-auto w-full max-w-2xl">
				<Footer />
			</div>
		</div>
		<FloatingNav client:load pathname={Astro.url.pathname} />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
	}
</style>
