{
	"name": "damitzi.com",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"cf-typegen": "wrangler types --env-interface CloudflareBindings --env-file /dev/null",
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"env:check": "varlock load --agent",
		"vinyls:sync": "varlock run --inject vars -- node scripts/sync-vinyls.mjs",
		"vinyls:check": "node scripts/check-vinyl-covers.mjs",
		"format": "oxfmt && prettier --write \"**/*.astro\"",
		"format:check": "oxfmt --check && prettier --check \"**/*.astro\"",
		"prepare": "husky",
		"lint": "oxlint && eslint . && astro check && pnpm vinyls:check && pnpm format:check",
		"lint:fix": "oxlint --fix && eslint . --fix",
		"lint-staged": "lint-staged"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.3",
		"@astrojs/mdx": "^7.0.8",
		"@astrojs/svelte": "^9.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/lora": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/svelte": "^1.1.5",
		"@paper-design/shaders": "0.0.80",
		"@varlock/astro-integration": "1.4.2",
		"@varlock/cloudflare-integration": "1.6.0",
		"astro": "^7.3.5",
		"clsx": "^2.1.1",
		"gsap": "^3.15.0",
		"sharp": "^0.34.5",
		"svelte": "^5.57.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"varlock": "1.20.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@cloudflare/workers-types": "^5.20260925.2",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.5",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.8",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-oxlint": "^1.85.0",
		"eslint-plugin-svelte": "^3.23.0",
		"eslint-plugin-unicorn": "^60.0.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^7.3.6",
		"vite-plugin-devtools-json": "^1.1.0",
		"wrangler": "^4.141.0"
	},
	"packageManager": "pnpm@10.33.2",
	"lint-staged": {
		"*.{js,jsx,ts,tsx,astro,svelte}": "oxlint --fix",
		"*.{astro,svelte}": "eslint --fix",
		"*.{js,jsx,ts,tsx,svelte,json,jsonc,css,md,mdx,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern",
		"*.astro": "prettier --write"
	}
}
