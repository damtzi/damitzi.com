# Local secrets for `pnpm build` and `pnpm dev`. Copy to .dev.vars and fill in
# real values. Required because prerendered pages fetch live data from Discogs
# and Strava at build time. `pnpm check` and `pnpm lint` do not need these.
DISCOGS_TOKEN=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
