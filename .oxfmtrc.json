{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortPackageJson": false,
	"sortTailwindcss": {
		"stylesheet": "./src/styles/global.css"
	},
	"svelte": {},
	"ignorePatterns": [
		".agents/",
		"**/*.astro",
		"pnpm-lock.yaml",
		"worker-configuration.d.ts",
		"dist/",
		".astro/",
		"node_modules/",
		"npm-debug.log*",
		"yarn-debug.log*",
		"yarn-error.log*",
		"pnpm-debug.log*",
		".env",
		".env.production",
		".DS_Store",
		".idea/"
	]
}
